model {
  qdrant = database 'Vector Store' {
    #external
    technology 'Qdrant'
    description 'Stores and searches document embeddings'
    style { color muted }
  }

  embedder = system 'Embedder' {
    #external
    technology 'HTTP / OpenAI API'
    description 'Encodes text into embeddings'
    style { color muted }
  }

  reranker = system 'Reranker' {
    #external
    technology 'HTTP / OpenAI API'
    description 'Reorders retrieved candidates by relevance'
    style { color muted }
  }

  llm = system 'LLM' {
    #external
    technology 'HTTP / OpenAI API'
    description 'Generates answers from retrieved context'
    style { color muted }
  }

  docling = system 'Docling' {
    #external
    technology 'docling-serve'
    description 'Converts and chunks documents'
    style { color muted }
  }

  webhook = system 'Webhook Receiver' {
    #external
    technology 'HTTP'
    description 'Caller endpoint notified when an ingestion job finishes'
    style { color muted }
  }

  user -> rag 'ingests documents / asks questions' 'HTTP'
  rag -> reranker 'reranks retrieved chunks' 'HTTP'
  rag -> llm 'generates answers' 'HTTP'
}
